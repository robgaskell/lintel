{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the document windows",
  "windows": ["main", "w-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-background-color",
    "core:webview:allow-set-webview-background-color",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "allow-normalize-path",
    "allow-paths-exist",
    "allow-read-image-as-data-uri",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-fetch-remote-image",
    "allow-claim-path",
    "allow-release-path",
    "allow-transfer-path",
    "allow-complete-handoff",
    "allow-cancel-handoff",
    "allow-handoff-status",
    "allow-set-window-appearance",
    "allow-frontend-ready",
    "allow-watch-path",
    "allow-unwatch-path",
    "allow-update-settings",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "**" }] },
    "opener:default",
    "process:allow-exit",
    "process:allow-restart",
    "store:default",
    "window-state:allow-save-window-state"
  ]
}
