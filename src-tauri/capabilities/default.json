{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "**" }] },
    "process:allow-exit",
    "process:allow-restart",
    "store:default"
  ]
}
